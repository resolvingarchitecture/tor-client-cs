<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Ra.Tor</RootNamespace>
    <AssemblyName>Ra.Tor</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Ra.Tor</PackageId>
    <Version>0.1.0</Version>
    <Authors>Brian Taylor</Authors>
    <Description>A local-only Tor client for the RA / 1M5 ecosystem (attaches to a host Tor daemon's SOCKS proxy).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/resolvingarchitecture/tor-cs</RepositoryUrl>
    <PackageTags>tor;socks5;network;1m5;resolving-architecture</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\common\ra-common-cs\src\RaCommon\RaCommon.csproj" />
  </ItemGroup>

</Project>
